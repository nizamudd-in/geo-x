# GeoSense-X — Environment Variables
# Copy to .env and adjust for your setup.

# ── Model ──────────────────────────────────────────────────────────────────
# Variants: dinov2_vits14 (384-d, fast) | dinov2_vitb14 (768-d) | dinov2_vitl14 (1024-d)
DINOV2_MODEL=dinov2_vitb14
EMBEDDING_DIM=768
DEVICE=cpu                  # cpu | cuda | mps

# ── Paths ──────────────────────────────────────────────────────────────────
FAISS_INDEX_DIR=indexes
EMBEDDINGS_DIR=embeddings
METADATA_PATH=embeddings/metadata.json
THUMBNAILS_DIR=static/thumbnails

# ── Search ─────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=10
MAX_TOP_K=10
MAX_FILE_SIZE_MB=50

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true
